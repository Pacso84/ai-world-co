# ===== API KULCSOK SABLON =====
#
# Hogyan használd:
# 1. Másold át ezt a fájlt ".env" néven (a pont fontos!)
# 2. Töltsd ki a saját kulcsaiddal
# 3. SOHA ne kommitold a .env fájlt! (a .gitignore már védi)
#
# A # jellel kezdődő sorok megjegyzések, nem aktívak.

# --- Anthropic (Claude) ---
# Honnan: https://console.anthropic.com/  →  API Keys
ANTHROPIC_API_KEY=sk-ant-api03-IDE_JON_A_KULCS

# --- Google (Gemini) ---
# Honnan: https://aistudio.google.com/apikey
GOOGLE_API_KEY=AIzaSy_IDE_JON_A_KULCS

# --- OpenAI (GPT) ---  [opcionális, későbbre]
# Honnan: https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-IDE_JON_A_KULCS

# --- Telegram Bot ---  [4. fázishoz]
# Honnan: Telegram → @BotFather → /newbot
# TELEGRAM_BOT_TOKEN=123456789:ABC...
# TELEGRAM_CHAT_ID=ide_jon_a_te_chat_azonositod
