    "groq":      { "key_env": "GROQ_API_KEY",      "cost": "free",  "free_notes": "Ingyenes, de kis TPM limit (~12k).", "best_for": ["speed", "chat", "json"], "notes": "Nagyon gyors; nagy prompthoz kevés a limit (413)." },
    "cerebras":  { "key_env": "CEREBRAS_API_KEY",  "cost": "free",  "free_notes": "Ingyenes, gyors, nagy modell (gpt-oss-120b).", "best_for": ["long-form", "speed", "writing", "cheap"], "notes": "Hosszú íráshoz kiváló és ingyen — az útmutató-író fő modellje." },
    "anthropic": { "key_env": "ANTHROPIC_API_KEY", "cost": "paid",  "best_for": ["quality", "reasoning", "long-form", "writing", "review"], "notes": "FIZETŐS. A legjobb minőség íráshoz/ellenőrzéshez — csak ha az ingyenes nem elég jó." },
    "mistral":   { "key_env": "MISTRAL_API_KEY",   "cost": "free",  "free_notes": "Van ingyenes tier (la Plateforme).", "best_for": ["chat", "cheap", "eu-privacy"], "notes": "EU-s, adatvédelem-barát; jó redundancia." },
    "openrouter":{ "key_env": "OPENROUTER_API_KEY","cost": "freemium", "free_notes": "Néhány modell ingyen (:free), a többi pay-per-use.", "best_for": ["variety", "fallback"], "notes": "Sok modellhez egy kulcs — jó meta-fallback." },
    "perplexity":{ "key_env": "PERPLEXITY_API_KEY","cost": "freemium", "free_notes": "Korlátozott ingyenes kredit; Sonar modellek.", "best_for": ["research-web", "citations"], "notes": "WEBES kutatás FORRÁSMEGJELÖLÉSSEL — erre nincs jelenleg bekötött gyártónk." },
    "openai":    { "key_env": "OPENAI_API_KEY",    "cost": "paid",  "best_for": ["image-generate", "image-edit", "voice", "chat"], "notes": "FIZETŐS. Natív képgenerálás/szerkesztés és hang. A képgenerálást ingyen a Cloudflare Flux is megoldja." },
    "deepseek":  { "key_env": "DEEPSEEK_API_KEY",  "cost": "cheap", "best_for": ["reasoning", "code", "cheap"], "notes": "Nagyon olcsó; erős reasoning/kód." },
